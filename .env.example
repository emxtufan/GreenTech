# Template for .env — safe to commit. Copy it and fill in real values:
#   cp .env.example .env
# .env itself is gitignored and must never be committed.

# Password for the /admin content panel.
# Required in production: the server refuses to boot without it.
# In development, leaving it unset generates a throwaway password and prints
# it at startup, which changes on every restart.
ADMIN_PASSWORD=

# Signs admin session cookies (HMAC key). Use a long random value, e.g.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Leaving it blank generates a new key each boot, which signs out open sessions
# on every restart and breaks multi-instance deployments.
SESSION_SECRET=

# Application content and form submissions are stored as local JSON files.
# Runtime state is separated from Git so pulls cannot overwrite live changes.
DATA_DIR=storage/data
UPLOADS_DIR=storage/uploads
TRANSLATIONS_DIR=storage/translations
# Run one PM2 instance and include storage/ in the server backup policy.

# Automatic public-site translations. The source content saved in admin is
# English; translated RO/IT/ES snapshots and phrase caches stay in storage/.
# Create a DeepL API key and keep it only on the server in .env.
DEEPL_API_KEY=
TRANSLATION_LOCALES=ro,it,es
# Optional. Normally selected automatically from the API key type (:fx = Free).
# DEEPL_API_URL=https://api-free.deepl.com/v2/translate

# Identifies this low-volume admin geocoder to the OpenStreetMap service.
# Keep a real company URL or contact address in this value when deploying.
GEOCODER_USER_AGENT="GreenTechProfessionalsAdmin/1.0 (+https://greentechpro.ro)"

# Optional: point to a self-hosted or contracted Nominatim-compatible service.
# GEOCODER_URL=https://nominatim.openstreetmap.org/search

# Server binding.
PORT=3000
HOST=0.0.0.0
