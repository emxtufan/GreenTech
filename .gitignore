# Dependencies
/node_modules/

# Build caches. dist/ is intentionally tracked for Git-based deployment.
/production-package/
/GreenTech-Production.zip
/.vite/
/coverage/
*.tsbuildinfo
.eslintcache
.stylelintcache

# Local configuration and secrets
.env
.env.*
!.env.example
*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors and operating systems
/.vscode/
/.idea/
*.suo
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Local agent and temporary files
/.agents/
/.claude/
/.codex/
*.tmp
*.temp
*.bak
~$*

# Mutable production state. Seed content remains versioned in data/ and
# public/uploads/, while live changes are written under storage/.
/storage/
/public/uploads/*

# Content backups. site-content.json itself is tracked as live content.
data/site-content.backup.json
data/customer-reviews.backup.json
data/project-inquiries.json
data/project-inquiries.backup.json
data/site-content.2*.json

# Personal data submitted through public forms; never commit.
data/career-applications.json
data/career-applications.backup.json
data/applications/

# Local Lighthouse exports
/greentechpro.app-*.json
